rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEmailVerifiedAdmin() {
      return isAuthenticated() &&
        request.auth.token.email == 'hos098sam@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        isEmailVerifiedAdmin() ||
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        request.auth.token.role == 'teacher' ||
        isAdmin() ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'teacher')
      );
    }

    function isEnrolledStudent(courseId) {
      return isAuthenticated() && (
        (request.auth.token.enrolledCourses != null && courseId in request.auth.token.enrolledCourses) ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         courseId in firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.enrolledCourseIds)
      );
    }

    match /avatars/{userId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /submissions/{userId}/{allFiles=**} {
      allow read: if isOwner(userId) || isTeacher() || isAdmin();
      allow write: if isOwner(userId) &&
        request.resource.size < 15 * 1024 * 1024;
    }

    match /courses/{courseId}/{allFiles=**} {
      allow read: if isAdmin() || isTeacher() || isEnrolledStudent(courseId);
      allow write: if (isAdmin() || isTeacher()) &&
        request.resource.size < 500 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
