rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'hos098sam@gmail.com'
      );
    }

    function isTeacher() {
      return isAuthenticated() && (
        request.auth.token.role == 'teacher' ||
        isAdmin()
      );
    }

    function isParent() {
      return isAuthenticated() && request.auth.token.role == 'parent';
    }

    function isParentOf(studentId) {
      return isParent() &&
        exists(/databases/$(database)/documents/parents/$(request.auth.uid)) &&
        studentId in get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.linkedStudentIds;
    }

    match /users/{userId} {
      allow get: if isAuthenticated() && (isOwner(userId) || isAdmin() || isTeacher());
      allow list: if isAdmin() || isTeacher();
      allow create: if isAuthenticated() && isOwner(userId) && !request.resource.data.keys().hasAny(['password']);
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'password', 'admin']) &&
        request.resource.data.email == resource.data.email;
      allow delete: if isAdmin();
    }

    match /exams/{examId} {
      allow read: if isAuthenticated() && (isAdmin() || isTeacher());
      allow write: if isAdmin() || isTeacher();
    }

    match /question_banks/{bankId} {
      allow read: if isAuthenticated() && (isAdmin() || isTeacher());
      allow write: if isAdmin() || isTeacher();
    }

    match /model_answers/{answerId} {
      allow read: if isAuthenticated() && (isAdmin() || isTeacher());
      allow write: if isAdmin() || isTeacher();
    }

    match /exam_answers/{answerId} {
      allow read: if isAuthenticated() && (isAdmin() || isTeacher());
      allow write: if isAdmin() || isTeacher();
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if isAuthenticated() && (isAdmin() || isTeacher());
      allow write: if isAdmin() || isTeacher();
    }

    match /access_codes/{codeId} {
      allow read: if isAuthenticated() && (isAdmin() || isTeacher());
      allow write: if isAdmin() || isTeacher();
    }

    match /fawaterak_invoices/{invoiceId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /al_motafalsifa_data/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isTeacher();
    }

    match /parents/{parentUid} {
      allow read: if isOwner(parentUid) || isAdmin();
      allow write: if isAdmin();
    }

    match /courses/{courseId} {
      allow read: if resource.data.isPublished == true || isTeacher() || isAdmin();
      allow create: if isTeacher() || isAdmin();
      allow update, delete: if (isTeacher() && resource.data.teacherId == request.auth.uid) || isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isParentOf(resource.data.studentId) || isTeacher() || isAdmin());
      allow write: if isAdmin() || isTeacher();
    }

    match /submissions/{submissionId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isParentOf(resource.data.studentId) || isTeacher() || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isTeacher() || isAdmin();
      allow delete: if isAdmin();
    }

    match /exam_results/{resultId} {
      allow read: if isAuthenticated() && (resource.data.studentId == request.auth.uid || isParentOf(resource.data.studentId) || isTeacher() || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin() || isTeacher();
    }

    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /forum_posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.targetUserId == request.auth.uid || resource.data.targetUserId == 'all');
      allow write: if isAdmin() || isTeacher();
    }

    match /competitions/{compId} {
      allow read: if true;
      allow write: if isAdmin() || isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
