rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isTeacher() {
      return signedIn() && (isAdmin() || request.auth.token.role == 'teacher');
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // User profiles are private by default. A user can read their own profile;
    // privileged access is based on verified Auth custom claims, never profile fields.
    match /users/{userId} {
      allow get: if owns(userId) || isTeacher();
      allow list: if isAdmin();
      allow create: if owns(userId)
        && !request.resource.data.keys().hasAny([
          'role', 'admin', 'permissions', 'status', 'walletBalance',
          'enrolledCourseIds', 'password'
        ]);
      allow update: if isAdmin() || (owns(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'admin', 'permissions', 'status', 'walletBalance',
          'enrolledCourseIds', 'password', 'activeSessionId', 'currentDeviceId'
        ]));
      allow delete: if isAdmin();
    }

    // Public catalog data is readable; changes require trusted custom claims.
    match /courses/{courseId} {
      allow read: if resource.data.isPublished == true || isTeacher();
      allow create: if isTeacher();
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /al_motafalsifa_data/{documentId} {
      allow read: if documentId in ['courses', 'settings', 'competitions', 'notifications'];
      allow read: if isTeacher() && documentId in [
        'users', 'submissions', 'exams', 'accessCodes', 'wallet_codes',
        'deleted_ids', 'support_chats'
      ];
      allow write: if isAdmin() || (isTeacher() && documentId in [
        'courses', 'settings', 'competitions', 'notifications', 'exams'
      ]);
    }

    match /parents/{parentId} {
      allow get: if owns(parentId) || isAdmin();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin() || isTeacher() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if isAdmin() || isTeacher() || (signedIn() && resource.data.studentId == request.auth.uid);
      // Submission scoring must be performed by a trusted server, not client-side writes.
      allow create, update, delete: if false;
    }

    match /exam_results/{resultId} {
      allow read: if isAdmin() || isTeacher() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /exams/{examId} {
      allow read, write: if isTeacher();
    }

    match /question_banks/{bankId} {
      allow read, write: if isTeacher();
    }

    match /model_answers/{answerId} {
      allow read, write: if isTeacher();
    }

    match /exam_answers/{answerId} {
      allow read, write: if isTeacher();
    }

    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read, write: if isAdmin();
    }

    match /access_codes/{codeId} {
      allow read, write: if isAdmin();
    }

    match /fawaterak_invoices/{invoiceId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /forum_posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin() || (signedIn() && resource.data.authorId == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow read: if signedIn() && (resource.data.targetUserId == request.auth.uid || resource.data.targetUserId == 'all');
      allow write: if isTeacher();
    }

    match /competitions/{competitionId} {
      allow read: if resource.data.isPublished == true || isTeacher();
      allow write: if isTeacher();
    }

    // Explicit deny-by-default for every unhandled collection/document.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
